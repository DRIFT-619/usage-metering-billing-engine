# Used ONLY by `npm test`. Dummy values — safe to commit.
# The tests TRUNCATE tables, so this must point at a database whose name ends in _test.
PORT=0
NODE_ENV=test
DATABASE_URL=postgres://billing:billing@localhost:5433/billing_engine_test

# Fake Stripe values: the tests sign their own webhook payloads with this
# secret and never call Stripe's real API.
STRIPE_SECRET_KEY=sk_test_dummy_for_unit_tests
STRIPE_WEBHOOK_SECRET=whsec_test_dummy_secret
STRIPE_PRO_PRICE_ID=price_test_pro