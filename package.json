{
  "name": "usage-metering-billing-engine",
  "version": "1.0.0",
  "description": "A usage metering, quota enforcement, and Stripe billing engine built for the FlyRank Backend Internship capstone.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "predev": "node scripts/ensure-env.js",
    "dev": "dotenv -e .env -- node --watch src/server.js",
    "prestart": "node scripts/ensure-env.js",
    "start": "dotenv -e .env -- node src/server.js",
    "premigrate:up": "node scripts/ensure-env.js",
    "migrate:up": "dotenv -e .env -- npx node-pg-migrate up",
    "migrate:down": "dotenv -e .env -- npx node-pg-migrate down",
    "migrate:create": "npx node-pg-migrate create",
    "preseed": "node scripts/ensure-env.js",
    "seed": "dotenv -e .env -- node scripts/seed.js",
    "test": "dotenv -e .env.test -- node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "job:rollover": "dotenv -e .env -- node scripts/run-rollover.js"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.12.0",
    "stripe": "^16.8.0",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "glob": "^11.1.0",
    "qs": "^6.16.0"
  }
}
