# Server
PORT=3000
NODE_ENV=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://billing:billing@localhost:5432/billing_engine

# Stripe TEST MODE ONLY — never put a live key here
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_stripe_listen
STRIPE_PRO_PRICE_ID=price_your_test_price_id_here

# Where Stripe should send the customer after Checkout (any local URL is fine)
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel
